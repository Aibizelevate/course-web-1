# Copy these into Vercel: Project -> Settings -> Environment Variables.
# Never commit real values to git.

# From Creem dashboard -> API keys
CREEM_API_KEY=

# From Creem dashboard -> the $99 product you already created
CREEM_PRODUCT_ID=

# From Creem dashboard -> Developers -> Webhooks -> your endpoint's signing secret
CREEM_WEBHOOK_SECRET=

# "true" while testing with Creem test mode, "false" (or unset) once live
CREEM_TEST_MODE=false

# Optional: only needed if SITE_URL should differ from the request's own host
# SITE_URL=https://iammartinkrejci.com
